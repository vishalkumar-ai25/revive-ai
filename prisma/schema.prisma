// =============================================================================
// PRISMA SCHEMA — ReviveAI Payment Recovery Data Model
// =============================================================================
// Designed for: payment state tracking, multi-agent audit trails,
// batch simulation metrics, and compliant escalation logging.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — Single source of truth for all status/type values
// ---------------------------------------------------------------------------

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  RECOVERY_IN_PROGRESS
  RECOVERED
  DEAD
  EXPIRED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NETBANKING
  WALLET
  EMI
  MANDATE
}

enum FailureCategory {
  BANK_TIMEOUT
  INSUFFICIENT_FUNDS
  CARD_DECLINED
  NETWORK_ERROR
  UPI_PSP_ERROR
  OTP_EXPIRED
  LIMIT_EXCEEDED
  FRAUD_BLOCK
  MANDATE_EXPIRED
  CHECKOUT_ABANDONED
  SUBSCRIPTION_FAILED
  UNKNOWN
}

enum RecoveryStrategy {
  SMART_RETRY
  CUSTOMER_NUDGE
  ALT_PAYMENT
  ESCALATE_MERCHANT
  DO_NOTHING
}

enum RecoveryOutcome {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  STOPPED_BY_RULE
}

enum EscalationLevel {
  LEVEL_1_ONSCREEN
  LEVEL_2_EMAIL
  LEVEL_3_SMS
  LEVEL_4_MERCHANT_ALERT
  LEVEL_5_DEAD
}

// ---------------------------------------------------------------------------
// Core Models
// ---------------------------------------------------------------------------

/// Merchant using ReviveAI to recover failed payments.
model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@map("merchants")
}

/// Customer who attempted a payment.
model Customer {
  id             String   @id @default(cuid())
  email          String
  phone          String?
  totalPurchases Int      @default(0)
  lifetimeValue  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]

  @@map("customers")
}

/// A single payment attempt — the atomic unit of the system.
/// Tracks the full lifecycle from INITIATED through RECOVERED or DEAD.
model Payment {
  id               String        @id @default(cuid())
  externalId       String        @unique // Simulated Razorpay payment ID (pay_xxx)
  merchantId       String
  customerId       String
  amount           Float
  currency         String        @default("INR")
  method           PaymentMethod
  bank             String? // e.g. "HDFC", "SBI", "ICICI"
  upiApp           String? // e.g. "phonepe", "gpay", "paytm"
  status           PaymentStatus @default(INITIATED)
  errorCode        String?
  errorDescription String?

  // Subscription / Mandate context
  isRecurring    Boolean @default(false)
  subscriptionId String?
  mandateId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  failureEvent     FailureEvent?
  recoveryAttempts RecoveryAttempt[]
  auditLogs        AuditLog[]

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

/// Structured failure diagnosis produced by the Diagnosis Agent.
/// One-to-one with a failed Payment.
model FailureEvent {
  id                  String          @id @default(cuid())
  paymentId           String          @unique
  category            FailureCategory
  rootCause           String // Human-readable root cause explanation
  bankErrorCode       String?
  diagnosisConfidence Float // 0.0 - 1.0
  isRecoverable       Boolean
  recoveryProbability Float // 0.0 - 1.0, set by Risk Assessment Agent

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("failure_events")
}

/// Each attempt to recover a failed payment.
/// A single Payment can have multiple recovery attempts (up to the stopping limit).
model RecoveryAttempt {
  id              String          @id @default(cuid())
  paymentId       String
  attemptNumber   Int
  strategy        RecoveryStrategy
  escalationLevel EscalationLevel
  outcome         RecoveryOutcome @default(PENDING)

  // Execution metadata
  scheduledAt    DateTime?
  executedAt     DateTime?
  channel        String? // "email", "sms", "onscreen", "merchant_dashboard"
  messageContent String?

  // If a stopping rule terminated this attempt, record which one
  stoppedByRule String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([outcome])
  @@map("recovery_attempts")
}

/// Immutable audit trail — every agent decision is logged here.
/// Satisfies the "audit trail" requirement from the judging criteria.
model AuditLog {
  id        String @id @default(cuid())
  paymentId String
  agentName String // "DiagnosisAgent", "RiskAssessmentAgent", "StrategyAgent", "RecoveryEngine"
  action    String // "DIAGNOSIS_COMPLETE", "RISK_ASSESSED", "STRATEGY_SELECTED", "NUDGE_SENT", etc.
  reasoning String // Why this decision was made — the agent's chain of thought
  metadata  Json? // Additional structured data (scores, timings, etc.)

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([agentName])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Aggregate results from a batch simulation run.
/// Used to display "measured money recovered" metrics.
model BatchRun {
  id                  String    @id @default(cuid())
  totalPayments       Int
  totalAmountAtRisk   Float
  paymentsRecovered   Int       @default(0)
  amountRecovered     Float     @default(0)
  recoveryRate        Float     @default(0)
  avgTimeToRecoverMs  Float? // Average time from failure to recovery

  // Strategy breakdown
  retriesAttempted    Int @default(0)
  nudgesSent          Int @default(0)
  altPaymentSuggested Int @default(0)
  escalatedToMerchant Int @default(0)
  stoppedByRules      Int @default(0)
  fraudBlocked        Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("batch_runs")
}
