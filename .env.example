# =============================================================================
# ReviveAI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Required variables will cause a startup error if missing.
# =============================================================================

# --- Database (Required) ---
# Local Docker Postgres default (matches docker-compose.yml):
DATABASE_URL="postgresql://revive:revive_dev@localhost:5432/revive_ai"
# Alternative hosted path (Neon / Supabase for cloud deployment / judging):
# DATABASE_URL="postgresql://user:password@host:5432/revive_ai?sslmode=require"

# --- AI / LLM (Required) ---
# Google AI Studio API key — get one free at https://aistudio.google.com/
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# --- Email Notifications (Optional — nudges disabled if missing) ---
# Resend API key for sending recovery emails — https://resend.com/
RESEND_API_KEY=""

# --- App Config (Optional) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Security (Required) ---
# Secret used to sign and verify payment recovery links. MUST be set in production.
RECOVERY_LINK_HMAC_SECRET="change_this_to_a_random_secure_string_like_a_uuid"
